{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "volcengine-design",
  "version": "0.1.2",
  "description": "Doubao ASR with millisecond word timelines, TTS narration, Seedream images and Seedance video. Two credential families stay separate and tasks are submitted once.",
  "author": {
    "name": "Full Stack Skills / PartMe.AI",
    "url": "https://github.com/partme-ai"
  },
  "homepage": "https://github.com/full-aigc-plugins/volcengine-design-plugin",
  "repository": "https://github.com/full-aigc-plugins/volcengine-design-plugin",
  "license": "Apache-2.0",
  "keywords": [
    "volcengine",
    "doubao",
    "asr",
    "tts",
    "seedance",
    "seedream"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Volcengine Design · Doubao Voice & Video",
        "shortDescription": "Word-level ASR, TTS narration, image and video generation",
        "logo": "./assets/official-logo.png",
        "logoDark": "./assets/official-logo.png",
        "composerIcon": "./assets/official-logo.png",
        "composerIconDark": "./assets/official-logo.png"
      }
    },
    "ai.nanoco.nanoclaw": {
      "agentName": "Volcengine Design"
    }
  }
}
